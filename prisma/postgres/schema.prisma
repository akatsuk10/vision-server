generator client {
  provider = "prisma-client-js"
  output = "../../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  name               String?
  email              String   @unique
  password           String?  // Nullable since user sets it after verification
  avatar             String?  // Optional profile image
  isEmailVerified    Boolean  @default(false)
  verificationToken  String?  @unique
  createdAt          DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  walletAddress      String?  @unique

  products           Product[]
  votes              Vote[]
  comments           Comment[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  tagline     String? // Short catchy tagline
  description String
  type        String? // Type of the product
  image       String
  tokenSymbol String? // Token symbol
  tokenImage  String? // Token image
  link        String
  website     String? // Official website
  status      String? // launched, coming soon, beta, etc.
  tags        String[] // Array of tags/categories
  featured    Boolean  @default(false) // For featured products
  launchDate  DateTime? // Date of launch
  hasPreInvestor Boolean @default(false) // Is there any pre investor?
  preValuationPrice Float? // Pre Valuation price of the Token
  initialDeposit    Float? // Initial deposit to pool
  sharesVC         Float? // Percentage of shares allotted for VC and Public
  ipoSlots         Int?   // No of IPO slots allotted
  makerNote        String? // Optional note from the maker/founder
  demoVideo        String? // URL to demo video (YouTube, etc.)
  bannerImage      String? // URL to banner image
  logo            String? // URL to logo image
  galleryImages   String[] // Array of gallery image URLs
  downloadLinks   String[] // Array of download/app store URLs
  pricingTag      String? // e.g., Free, Paid, Free trial
  promo           String? // Promo code or offer
  twitter         String? // Product/company Twitter handle
  firstComment    String? // Maker's first comment
  interactiveDemo String? // URL to interactive demo (Arcade, etc.)
  topics          String[] // Array of topics/categories
  makers          String[] // Array of co-maker names or IDs
  scheduleDate    DateTime? // Scheduled launch date
  views           Int      @default(0) // Product views
  upvotes         Int      @default(0) // Product upvotes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])
  votes       Vote[]
  comments    Comment[]
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId]) // Prevent duplicate votes
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  userId    String
  productId String

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}
